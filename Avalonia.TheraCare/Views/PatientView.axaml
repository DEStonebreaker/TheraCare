<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             xmlns:vm="clr-namespace:Avalonia.TheraCare.ViewModels"
             x:DataType="vm:PatientViewModel"
             x:Class="Avalonia.TheraCare.Views.PatientView">

    <Border>
            <Grid ColumnDefinitions="*, Auto, *"
                  Background="WhiteSmoke">
                <Grid Grid.Column="1"
                      Width="880">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="250"
                                Spacing="5">
                        <Button Content="Create Patient"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Content="Update Patient"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Content="Find Patient"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Content="Delete Patient"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Content="Back"
                                Command="{Binding GoToHome}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
    </Border>

    
</UserControl>

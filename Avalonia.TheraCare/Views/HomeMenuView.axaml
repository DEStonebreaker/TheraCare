<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Avalonia.TheraCare.ViewModels"
             x:DataType="vm:HomeMenuViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Avalonia.TheraCare.Views.HomeMenuView">

    <Panel Background="WhiteSmoke">
        <Grid RowDefinitions="*, Auto, 2*">
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Border Background="#782F40"
                        Height="30" Width="250"
                        CornerRadius="1"
                        Padding="0">
                    <TextBlock Text="User Directory"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Times New Roman"
                               FontSize="20"
                               Foreground="#FFFFFF" />
                </Border>
                <Button Content="Patient Actions"
                        Command="{Binding  GoToPatient}"
                        HorizontalContentAlignment="Center"
                        FontSize="18"
                        Width="250"
                        Background="Gray"
                        Foreground="Black"
                        CornerRadius="3"
                        Margin="0,4,0,2"
                        HorizontalAlignment="Center" />
                <Button Content="Physician Actions"
                        HorizontalContentAlignment="Center"
                        FontSize="18"
                        Width="250"
                        Background="Gray"
                        Foreground="Black"
                        CornerRadius="3"
                        Margin="0,2,0,2"
                        HorizontalAlignment="Center" />
                <Button Content="Exit"
                        HorizontalContentAlignment="Center"
                        FontSize="18"
                        Width="250"
                        Background="Gray"
                        Foreground="Black"
                        CornerRadius="3"
                        Margin="0,2,0,2"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Panel>

</UserControl>